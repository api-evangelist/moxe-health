          "SubscriberId",
          "PatientId",
          "PatientIdType",
          "DateOfBirth",
          "FirstName",
          "LastName",
          "AdministrativeGender",
          "VisitId",
          "PurposeOfUse",
          "RequestSourceId",
          "StartDate",
          "EndDate",
          "ClaimId",
          "DenialRemarkCode",
          "ProviderOrganizationId"
