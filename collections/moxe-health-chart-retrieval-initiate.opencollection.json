{
  "opencollection": "1.0.0",
  "info": {
    "name": "Chart Retrieval API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Patient",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Initiate Request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://${environment}-api.moxehealth.com/chart-retrieval/v1/patient-chart-request",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://${environment}-api.moxehealth.com/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Initiate a new request for patient data"
        }
      ]
    }
  ],
  "bundled": true
}