{
  "opencollection": "1.0.0",
  "info": {
    "name": "Chart Retrieval API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Claims",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Claim Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://${environment}-api.moxehealth.com/chart-retrieval/v1/claim-management-request/:moxeRequestId/status",
            "params": [
              {
                "name": "moxeRequestId",
                "value": "",
                "type": "path",
                "description": "The moxeRequestId provided by us when the claim-management-request in question was created"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "https://${environment}-api.moxehealth.com/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get the status of the specified claim management request"
        }
      ]
    }
  ],
  "bundled": true
}